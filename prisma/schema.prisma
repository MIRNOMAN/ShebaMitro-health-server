// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/pris-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  LAB
  PHARMACY
  ADMIN
}

enum AppointmentType {
  ONLINE
  CHAMBER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum MealTiming {
  BEFORE_MEAL
  AFTER_MEAL
  WITH_MEAL
  EMPTY_STOMACH
}

enum ReminderStatus {
  PENDING
  TAKEN
  SKIPPED
}

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  PROCESSING
  REPORT_READY
  CANCELLED
}

enum PharmacyOrderStatus {
  PENDING
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  DISPENSED
  CANCELLED
}

enum PaymentGateway {
  BKASH
  STRIPE
}

enum OrderType {
  APPOINTMENT
  LAB_ORDER
  PHARMACY_ORDER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum VitalType {
  HEART_RATE
  BP
  GLUCOSE
  SPO2
}

enum FamilyRelation {
  PARENT
  SPOUSE
  CHILD
}

// ──────────────────────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────────────────────

model User {
  id                  String           @id @default(uuid())
  name                String?
  email               String           @unique
  phone               String?          @unique
  passwordHash        String           @map("password_hash")
  role                Role             @default(PATIENT)
  isVerified          Boolean          @default(false) @map("is_verified")
  refreshTokenHash    String?          @map("refresh_token_hash")
  failedLoginAttempts Int              @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?        @map("lockout_until")
  deletedAt           DateTime?        @map("deleted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  labProfile          LabProfile?
  pharmacyProfile     PharmacyProfile?
  messages            Message[]
  familyMembers       FamilyMember[]

  @@index([email, role])
  @@index([phone, isVerified])
  @@map("users")
}

model PatientProfile {
  id               String             @id @default(uuid())
  userId           String             @unique @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup       String?            @map("blood_group")
  dob              DateTime?          @map("dob")
  gender           String?            @map("gender")
  emergencyContact String?            @map("emergency_contact")
  medicalAllergies String[]           @default([]) @map("medical_allergies")
  deletedAt        DateTime?          @map("deleted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  appointments     Appointment[]
  prescriptions    Prescription[]
  reminders        MedicineReminder[]
  labOrders        LabOrder[]
  pharmacyOrders   PharmacyOrder[]
  biometricVitals  BiometricVital[]
  vitalAlerts      VitalAlert[]
  emergencyRequests EmergencyRequest[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id              String               @id @default(uuid())
  userId          String               @unique @map("user_id")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bmdcRegNo       String               @unique @map("bmdc_reg_no")
  bmdcDocUrl      String?              @map("bmdc_doc_url")
  name            String?
  specialization  String
  qualifications  String[]             @default([])
  experienceYears Int                  @default(0) @map("experience_years")
  consultFee      Float                @default(0) @map("consult_fee")
  followUpFee     Float                @default(0) @map("follow_up_fee")
  isApproved      Boolean              @default(false) @map("is_approved")
  bio             String?
  hospital        String?
  gender          String?
  rating          Float                @default(0.0)
  reviewCount     Int                  @default(0) @map("review_count")
  deletedAt       DateTime?            @map("deleted_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  availabilities  DoctorAvailability[]
  appointments    Appointment[]
  prescriptions   Prescription[]
  vitalAlerts     VitalAlert[]

  @@index([specialization])
  @@index([consultFee])
  @@index([rating])
  @@map("doctor_profiles")
}

model LabProfile {
  id           String     @id @default(uuid())
  userId       String     @unique @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNo    String     @unique @map("license_no")
  labName      String     @map("lab_name")
  address      String
  testsOffered String[]   @default([]) @map("tests_offered")
  accreditation String?   @map("accreditation")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  labOrders    LabOrder[]
  labTests     LabTest[]

  @@map("lab_profiles")
}

model LabTest {
  id               String     @id @default(uuid())
  labId            String     @map("lab_id")
  lab              LabProfile @relation(fields: [labId], references: [id], onDelete: Cascade)
  testName         String     @map("test_name")
  category         String
  description      String?
  price            Float
  fastingRequired  Boolean    @default(false) @map("fasting_required")
  turnaroundHours  Int        @default(24) @map("turnaround_hours")
  labAccreditation String?    @map("lab_accreditation")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([testName])
  @@index([category])
  @@index([price])
  @@map("lab_tests")
}

model PharmacyProfile {
  id                String          @id @default(uuid())
  userId            String          @unique @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  drugLicenseNo     String          @unique @map("drug_license_no")
  tradeName         String          @map("trade_name")
  address           String
  deliveryAvailable Boolean         @default(false) @map("delivery_available")
  deletedAt         DateTime?       @map("deleted_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  pharmacyOrders    PharmacyOrder[]

  @@map("pharmacy_profiles")
}

model DoctorAvailability {
  id                  String        @id @default(uuid())
  doctorId            String        @map("doctor_id")
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek           String        @map("day_of_week")
  startTime           String        @map("start_time")
  endTime             String        @map("end_time")
  slotDurationMinutes Int           @default(30) @map("slot_duration_minutes")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([doctorId, dayOfWeek])
  @@map("doctor_availabilities")
}

model Appointment {
  id            String            @id @default(uuid())
  doctorId      String            @map("doctor_id")
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId     String            @map("patient_id")
  patient       PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  slotStartTime DateTime          @map("slot_start_time")
  slotEndTime   DateTime          @map("slot_end_time")
  type          AppointmentType   @default(ONLINE)
  status        AppointmentStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(UNPAID) @map("payment_status")
  meetingRoomId String?           @map("meeting_room_id")
  familyMemberId String?          @map("family_member_id")
  familyMember   FamilyMember?    @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  prescription  Prescription?
  messages      Message[]

  @@unique([doctorId, slotStartTime])
  @@index([doctorId, status])
  @@index([patientId, status])
  @@map("appointments")
}

model Prescription {
  id              String             @id @default(uuid())
  appointmentId   String             @unique @map("appointment_id")
  appointment     Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId        String             @map("doctor_id")
  doctor          DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId       String             @map("patient_id")
  patient         PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosis       String
  chiefComplaints String?            @map("chief_complaints")
  vitalsJson      Json?              @map("vitals_json")
  advice          String?
  followUpDate    DateTime?          @map("follow_up_date")
  overrideReason  String?            @map("override_reason")
  overrideJson    Json?              @map("override_json")
  qrCodeHash            String?            @map("qr_code_hash")
  pdfUrl                String?            @map("pdf_url")
  isDispensed           Boolean            @default(false) @map("is_dispensed")
  dispensedAt           DateTime?          @map("dispensed_at")
  dispensedByPharmacyId String?            @map("dispensed_by_pharmacy_id")
  familyMemberId        String?            @map("family_member_id")
  familyMember          FamilyMember?      @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  deletedAt             DateTime?          @map("deleted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  items           PrescriptionItem[]
  labOrders       LabOrder[]
  pharmacyOrders  PharmacyOrder[]

  @@index([doctorId])
  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String             @id @default(uuid())
  prescriptionId  String             @map("prescription_id")
  prescription    Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName    String             @map("medicine_name")
  genericName     String?            @map("generic_name")
  dosageForm      String?            @map("dosage_form")
  schedulePattern String             @map("schedule_pattern")
  mealTiming      MealTiming         @default(AFTER_MEAL) @map("meal_timing")
  durationDays    Int                @map("duration_days")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  reminders       MedicineReminder[]

  @@map("prescription_items")
}

model MedicineReminder {
  id                 String           @id @default(uuid())
  patientId          String           @map("patient_id")
  patient            PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionItemId String           @map("prescription_item_id")
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  intakeTime         DateTime         @map("intake_time")
  status             ReminderStatus   @default(PENDING)
  acknowledgedAt     DateTime?        @map("acknowledged_at")
  familyMemberId     String?          @map("family_member_id")
  familyMember       FamilyMember?    @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([patientId, intakeTime, status])
  @@map("medicine_reminders")
}

model LabOrder {
  id                      String         @id @default(uuid())
  prescriptionId          String?        @map("prescription_id")
  prescription            Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  patientId               String         @map("patient_id")
  patient                 PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labId                   String         @map("lab_id")
  lab                     LabProfile     @relation(fields: [labId], references: [id], onDelete: Cascade)
  testNames               String[]       @default([]) @map("test_names")
  totalFee                Float          @default(0) @map("total_fee")
  status                  LabOrderStatus @default(PENDING)
  sampleCollectionAddress String?        @map("sample_collection_address")
  sampleCollectionSlot    DateTime?      @map("sample_collection_slot")
  technicianName          String?        @map("technician_name")
  technicianPhone         String?        @map("technician_phone")
  technicianLatitude      Float?         @map("technician_latitude")
  technicianLongitude     Float?         @map("technician_longitude")
  reportPdfUrl            String?        @map("report_pdf_url")
  isEncrypted             Boolean        @default(false) @map("is_encrypted")
  notes                   String?
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  @@index([patientId, status])
  @@index([labId, status])
  @@map("lab_orders")
}

model PharmacyOrder {
  id              String              @id @default(uuid())
  prescriptionId  String?             @map("prescription_id")
  prescription    Prescription?       @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  patientId       String              @map("patient_id")
  patient         PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacyId      String              @map("pharmacy_id")
  pharmacy        PharmacyProfile     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  itemsJson       Json                @map("items_json")
  totalAmount     Float               @default(0) @map("total_amount")
  shippingAddress String              @map("shipping_address")
  status          PharmacyOrderStatus @default(PENDING)
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([patientId, status])
  @@index([pharmacyId, status])
  @@map("pharmacy_orders")
}

model Message {
  id            String      @id @default(uuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  senderId      String      @map("sender_id")
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String
  fileUrl       String?     @map("file_url")
  isRead        Boolean     @default(false) @map("is_read")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([appointmentId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Transaction {
  id                 String            @id @default(uuid())
  orderType          OrderType         @map("order_type")
  orderId            String            @map("order_id")
  paymentGateway     PaymentGateway    @map("payment_gateway")
  amount             Float
  currency           String            @default("BDT")
  status             TransactionStatus @default(PENDING)
  paymentIntentId    String?           @map("payment_intent_id")
  transactionId      String?           @map("transaction_id")
  idempotencyKey     String            @unique @map("idempotency_key")
  platformCommission Float             @default(0) @map("platform_commission")
  providerAmount     Float             @default(0) @map("provider_amount")
  providerId         String?           @map("provider_id")
  providerType       String?           @map("provider_type")
  metadataJson       Json?             @map("metadata_json")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([orderId, orderType])
  @@index([status])
  @@index([providerId])
  @@map("transactions")
}

model Wallet {
  id           String   @id @default(uuid())
  providerId   String   @unique @map("provider_id")
  providerType String   @map("provider_type")
  balance      Float    @default(0)
  totalEarned  Float    @default(0) @map("total_earned")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String?  @map("admin_user_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  detailsJson Json?    @map("details_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([action])
  @@map("audit_logs")
}

model Payout {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  providerType   String   @map("provider_type")
  amount         Float
  paymentMethod  String   @map("payment_method")
  accountDetails Json     @map("account_details")
  status         String   @default("DISBURSED")
  disbursedAt    DateTime @default(now()) @map("disbursed_at")
  transactionRef String?  @map("transaction_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([status])
  @@map("payouts")
}

model BiometricVital {
  id             String         @id @default(uuid())
  patientId      String         @map("patient_id")
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           VitalType
  value          Float
  unit           String
  recordedAt     DateTime       @map("recorded_at")
  idempotencyKey String?        @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  alerts         VitalAlert[]

  @@index([patientId, recordedAt])
  @@index([patientId, type])
  @@map("biometric_vitals")
}

model VitalAlert {
  id             String          @id @default(uuid())
  patientId      String          @map("patient_id")
  patient        PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?         @map("doctor_id")
  doctor         DoctorProfile?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  vitalId        String?         @map("vital_id")
  vital          BiometricVital? @relation(fields: [vitalId], references: [id], onDelete: Cascade)
  vitalType      VitalType       @map("vital_type")
  value          Float
  unit           String
  threshold      String
  severity       String          @default("EMERGENCY")
  message        String
  isAcknowledged Boolean         @default(false) @map("is_acknowledged")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([patientId])
  @@index([doctorId])
  @@map("vital_alerts")
}

model EmergencyRequest {
  id                    String          @id @default(uuid())
  patientId             String?         @map("patient_id")
  patient               PatientProfile? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  latitude              Float
  longitude             Float
  status                String          @default("DISPATCHED")
  trackingToken         String          @unique @map("tracking_token")
  trackingExpiresAt     DateTime        @map("tracking_expires_at")
  dispatchedAmbulanceId String?         @map("dispatched_ambulance_id")
  dispatchedAmbulance   Ambulance?      @relation(fields: [dispatchedAmbulanceId], references: [id], onDelete: SetNull)
  nearestHospitalId     String?         @map("nearest_hospital_id")
  nearestHospital       Hospital?       @relation(fields: [nearestHospitalId], references: [id], onDelete: SetNull)
  notes                 String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([status])
  @@map("emergency_requests")
}

model Ambulance {
  id            String             @id @default(uuid())
  driverName    String             @map("driver_name")
  driverPhone   String             @map("driver_phone")
  vehicleNumber String             @unique @map("vehicle_number")
  isVerified    Boolean            @default(true) @map("is_verified")
  isAvailable   Boolean            @default(true) @map("is_available")
  latitude      Float
  longitude     Float
  hospitalName  String?            @map("hospital_name")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  dispatches    EmergencyRequest[]

  @@map("ambulances")
}

model Hospital {
  id                String             @id @default(uuid())
  name              String
  address           String
  phone             String
  isVerified        Boolean            @default(true) @map("is_verified")
  latitude          Float
  longitude         Float
  emergencyServices String[]           @default(["ICU", "TRAUMA", "AMBULANCE"]) @map("emergency_services")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  emergencies       EmergencyRequest[]

  @@map("hospitals")
}

model FamilyMember {
  id            String         @id @default(uuid())
  primaryUserId String         @map("primary_user_id")
  primaryUser   User           @relation(fields: [primaryUserId], references: [id], onDelete: Cascade)
  fullName      String         @map("full_name")
  relation      FamilyRelation
  dob           DateTime?      @map("dob")
  gender        String?        @map("gender")
  bloodGroup    String?        @map("blood_group")
  allergies     String[]       @default([])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  appointments  Appointment[]
  prescriptions Prescription[]
  reminders     MedicineReminder[]

  @@index([primaryUserId])
  @@map("family_members")
}




